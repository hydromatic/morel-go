 *
 * Regression tests for morel-go behavior that morel-java's corpus
 * does not pin. Go-local, like parse.smli: the pull never touches
 * this file. Each remaining entry either has no upstream counterpart
 * or prints differently in morel-java, so it cannot move to a pulled
 * .smli file; each names the reason.
 *)

(* A tuple extent is a cartesian product. In "tabular" output morel-go
 * prints a unit value as "()" where morel-java prints "{}", so this
 * stays here rather than in such-that.smli. *)
from bc where bc = (true, ()) orelse true;
> val it = [(false,()),(true,())] : (bool * unit) bag

