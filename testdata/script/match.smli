 * Pattern matching
 *)

(*) Warning: match nonexhaustive

(*) OK
fun f 1 = 0
  | f _ = 1;
> val f = fn : int -> int
f 1;
> val it = 0 : int
f 2;
> val it = 1 : int

(* The Ackermann-Péter function
 * See "Recursion Equations as a Programming Language", D A Turner 1982 *)
fun ack 0 n = n + 1
  | ack m 0 = ack (m - 1) 1
  | ack m n = ack (m - 1) (ack m (n - 1));
> val ack = fn : int -> int -> int
ack 0 0;
> val it = 1 : int
ack 0 1;
> val it = 2 : int
ack 1 0;
> val it = 2 : int
ack 1 2;
> val it = 4 : int
ack 2 3;
> val it = 9 : int
ack 3 3;
> val it = 61 : int

(* Various types, exhaustive & non-exhaustive --------------------- *)
(*) From https://smlhelp.github.io/book/docs/start/syntax/

(*) unit, exhaustive
(fn () => ());
> val it = fn : unit -> unit

(*) bool, exhaustive
(fn true  => 1
  | false => 0);
> val it = fn : bool -> int

(*) order, exhaustive
(fn LESS    => ~1
  | EQUAL   => 0
  | GREATER => 1);
> val it = fn : order -> int

(*) order, exhaustive
(fn 0 => true
  | _ => false);
> val it = fn : int -> bool

(*) int list, exhaustive
(fn [] => 0
  | x::_ => x + 1);
> val it = fn : int list -> int

(*) int * bool, exhaustive
(fn (0,b) => true andalso b
  | (n,_) => false);
> val it = fn : int * bool -> bool

(*) Exhaustive
fun f [(SOME i)] = i
  | f [NONE] = ~1
  | f [] = 0
  | f (one :: two :: rest) = ~2;
> val f = fn : int option list -> int

datatype color = RED | GREEN | BLUE;
> datatype color = RED | GREEN | BLUE

(* Matching values ------------------------------------------------ *)

(*) "case" with constant, variable and wildcard patterns.
case 3 of 0 => "zero" | _ => "nonzero";
> val it = "nonzero" : string
case 0 of 0 => "zero" | _ => "nonzero";
> val it = "zero" : string
case 42 of n => n;
> val it = 42 : int
case 7 of 0 => 0 | n => n;
> val it = 7 : int
case "a" of "a" => 1 | _ => 2;
> val it = 1 : int
val n = 5;
> val n = 5 : int
case n of 5 => true | _ => false;
> val it = true : bool

(*) List patterns in "case".
case [1] of [x] => x | _ => 0;
> val it = 1 : int
case [1, 2] of [x] => x | _ => 0;
> val it = 0 : int

(*) Multi-clause "fn" expressions.
val h = fn 0 => "zero" | _ => "other";
> val h = fn : int -> string
h 0;
> val it = "zero" : string
h 5;
> val it = "other" : string
(fn 1 => true | n => false) 3;
> val it = false : bool

(*) Nested-tuple and record "val" patterns, and one that binds nothing.
val (a, (b, c)) = (1, (2, 3));
> val a = 1 : int
> val b = 2 : int
> val c = 3 : int
val {a=p, b=q} = {a=4, b=5};
> val p = 4 : int
> val q = 5 : int
val _ = 9;
let val (i, j) = (2, 3) in (j, i) end;
> val it = (3,2) : int * int

(*) End match.smli
